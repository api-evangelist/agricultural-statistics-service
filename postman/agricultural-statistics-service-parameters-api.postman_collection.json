        {
          "name": "USDA NASS Get Parameter Values",
          "id": "e841eab9-9737-4668-bff2-a2c6869b3de2",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/get_param_values?key=<string>&param=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "get_param_values"
              ],
              "query": [
                {
                  "description": "(Required) API key.",
                  "key": "key",
                  "value": "<string>"
                },
                {
                  "description": "(Required) The parameter name for which to return all valid values (e.g., commodity_desc, state_alpha, statisticcat_desc).",
                  "key": "param",
                  "value": "<string>"
                }
              ]
            },
            "description": "Returns all possible values for a specified QuickStats parameter, helping users discover valid values for building queries. Useful for finding valid commodity names, state codes, statistical categories, and other parameter values."
