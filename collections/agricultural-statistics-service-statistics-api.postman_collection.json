      "item": [
        {
          "id": "3d266937-eb54-4f14-9fe2-4f9ed2b2b2d6",
          "name": "USDA NASS Get Statistics",
          "request": {
            "name": "USDA NASS Get Statistics",
            "description": {
              "content": "Retrieves agricultural statistics data records from the Quick Stats database. Supports filtering by commodity, location, time period, and statistical category using comparison operators. Returns up to 50,000 records per request. Response formats include JSON (default), XML, and CSV.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api_GET"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) API key obtained by registering at the QuickStats API portal."
                },
                {
                  "disabled": false,
                  "key": "commodity_desc",
                  "value": "<string>",
                  "description": "Commodity description (e.g., CORN, SOYBEANS, CATTLE)."
                },
                {
                  "disabled": false,
                  "key": "class_desc",
                  "value": "<string>",
                  "description": "Commodity class description."
                },
                {
                  "disabled": false,
                  "key": "statisticcat_desc",
                  "value": "<string>",
                  "description": "Statistical category (e.g., AREA HARVESTED, PRODUCTION, PRICE RECEIVED)."
                },
                {
                  "disabled": false,
                  "key": "unit_desc",
                  "value": "<string>",
                  "description": "Unit of measurement (e.g., ACRES, BU, HEAD)."
                },
                {
                  "disabled": false,
                  "key": "sector_desc",
                  "value": "<string>",
                  "description": "Sector or division of the agricultural economy."
                },
                {
                  "disabled": false,
                  "key": "group_desc",
                  "value": "<string>",
                  "description": "Commodity group description (e.g., FIELD CROPS, VEGETABLES)."
                },
                {
                  "disabled": false,
                  "key": "state_alpha",
                  "value": "<string>",
                  "description": "Two-letter state abbreviation (e.g., VA, IA, TX)."
                },
                {
                  "disabled": false,
                  "key": "state_name",
                  "value": "<string>",
                  "description": "Full state name."
                },
                {
                  "disabled": false,
                  "key": "county_name",
                  "value": "<string>",
                  "description": "County name."
                },
                {
                  "disabled": false,
                  "key": "agg_level_desc",
                  "value": "<string>",
                  "description": "Geographic aggregation level (NATIONAL, STATE, COUNTY, ZIP CODE)."
                },
                {
                  "disabled": false,
                  "key": "year",
                  "value": "<integer>",
                  "description": "Survey year (e.g., 2023). Supports operators like year__GE=2010."
                },
                {
                  "disabled": false,
                  "key": "year__GE",
                  "value": "<integer>",
                  "description": "Year greater than or equal to specified value."
                },
                {
                  "disabled": false,
                  "key": "year__LE",
                  "value": "<integer>",
                  "description": "Year less than or equal to specified value."
                },
                {
                  "disabled": false,
                  "key": "freq_desc",
                  "value": "<string>",
                  "description": "Data collection frequency (ANNUAL, MONTHLY, WEEKLY, POINT IN TIME, SEASONAL)."
                },
                {
                  "disabled": false,
                  "key": "reference_period_desc",
                  "value": "<string>",
                  "description": "Reference period description (e.g., YEAR, JAN, JUN)."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Response format (JSON, XML, CSV). Defaults to JSON."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<string>",
                  "description": "JSONP callback function name for cross-origin requests."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
