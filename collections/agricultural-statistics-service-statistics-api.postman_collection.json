                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) API key."
                },
                {
                  "disabled": false,
                  "key": "commodity_desc",
                  "value": "<string>",
                  "description": "Commodity description to count records for."
                },
                {
                  "disabled": false,
                  "key": "state_alpha",
                  "value": "<string>",
                  "description": "State abbreviation to filter."
                },
                {
                  "disabled": false,
                  "key": "year__GE",
                  "value": "<integer>",
                  "description": "Year filter (greater than or equal)."
                }
              ],
              "variable": []
