        {
          "id": "5d932634-2ba9-41db-9fc3-2b4b51c6e73f",
          "name": "USDA NASS Get Record Counts",
          "request": {
            "name": "USDA NASS Get Record Counts",
            "description": {
              "content": "Returns the total count of records that would be returned by a given query without fetching the actual data. Useful for validating queries before making full data requests, particularly to ensure results stay within the 50,000 record limit.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "get_counts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
