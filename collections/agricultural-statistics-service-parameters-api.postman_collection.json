                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"param_values\": [\n    \"CORN\",\n    \"SOYBEANS\",\n    \"WHEAT\",\n    \"CATTLE\",\n    \"HOGS\"\n  ]\n}",
